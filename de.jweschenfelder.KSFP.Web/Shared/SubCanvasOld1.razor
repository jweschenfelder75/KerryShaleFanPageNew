@inject IJSRuntime jsRuntime

<div class="row">
	<div class="col-12">
		<p class="text-black text-center text-nowrap d-block">
			<h3 class="text-center fw-bold text-nowrap d-inline-block">Test</h3>&nbsp;
			<BlazorBootstrap.Icon Name="@BlazorBootstrap.IconName.InfoCircleFill" Color="BlazorBootstrap.IconColor.Info" data-blazorstrap="tt-info-webgl" />
			<BSTooltip Placement="Placement.Top" Target="tt-info-webgl">WebGL (experimental, <br/>using THREE.JS)</BSTooltip>
		</p>
	</div>
</div>
<div class="row">
	<div class="col-12">
		<p class="text-black text-center">
			<canvas id="@canvasId" style="height: 200px; width: 200px;"></canvas>
		</p>
	</div>
</div>


@code {
	const string canvasId = "canvas-id";

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		object[] args = { canvasId };
		await jsRuntime.InvokeVoidAsync("threeExample", args);
	}
}