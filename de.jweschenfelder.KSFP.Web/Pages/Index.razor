@code {
	string hour1NormalTimeCont = "0 0";
	string hour2NormalTimeCont = "0 0";
	string minute1NormalTimeCont = "0 0";
	string minute2NormalTimeCont = "0 0";
	string second1NormalTimeCont = "0 0";
	string second2NormalTimeCont = "0 0";
	string hour1ShaleTimeCont = "0 0";
	string hour2ShaleTimeCont = "0 0";
	string minute1ShaleTimeCont = "0 0";
	string minute2ShaleTimeCont = "0 0";
	string second1ShaleTimeCont = "0 0";
	string second2ShaleTimeCont = "0 0";

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();

		var timer = new System.Threading.Timer((_) =>
		{
			InvokeAsync(() =>
			{
				UpdateTime();
				StateHasChanged();
			});
		}, null, 0, 1000);
	}

	private void UpdateTime()
	{
		var britishTime = DateTime.Now;
		var shaleTime = DateTime.Now.AddMinutes(10);
		var britishTimeCurr = britishTime.ToString("HH:mm:ss");
		var britishTimePrev = britishTime.AddSeconds(-1).ToString("HH:mm:ss");
		var shaleTimeCurr = shaleTime.ToString("HH:mm:ss");
		var shaleTimePrev = shaleTime.AddSeconds(-1).ToString("HH:mm:ss");

		var hour1NormalTimeCurr = int.Parse(britishTimeCurr[0].ToString(), NumberStyles.Integer);
		var hour2NormalTimeCurr = int.Parse(britishTimeCurr[1].ToString(), NumberStyles.Integer);
		var minute1NormalTimeCurr = int.Parse(britishTimeCurr[3].ToString(), NumberStyles.Integer);
		var minute2NormalTimeCurr = int.Parse(britishTimeCurr[4].ToString(), NumberStyles.Integer);
		var second1NormalTimeCurr = int.Parse(britishTimeCurr[6].ToString(), NumberStyles.Integer);
		var second2NormalTimeCurr = int.Parse(britishTimeCurr[7].ToString(), NumberStyles.Integer);
		var hour1ShaleTimeCurr = int.Parse(shaleTimeCurr[0].ToString(), NumberStyles.Integer);
		var hour2ShaleTimeCurr = int.Parse(shaleTimeCurr[1].ToString(), NumberStyles.Integer);
		var minute1ShaleTimeCurr = int.Parse(shaleTimeCurr[3].ToString(), NumberStyles.Integer);
		var minute2ShaleTimeCurr = int.Parse(shaleTimeCurr[4].ToString(), NumberStyles.Integer);
		var second1ShaleTimeCurr = int.Parse(shaleTimeCurr[6].ToString(), NumberStyles.Integer);
		var second2ShaleTimeCurr = int.Parse(shaleTimeCurr[7].ToString(), NumberStyles.Integer);

		var hour1NormalTimePrev = int.Parse(britishTimePrev[0].ToString(), NumberStyles.Integer);
		var hour2NormalTimePrev = int.Parse(britishTimePrev[1].ToString(), NumberStyles.Integer);
		var minute1NormalTimePrev = int.Parse(britishTimePrev[3].ToString(), NumberStyles.Integer);
		var minute2NormalTimePrev = int.Parse(britishTimePrev[4].ToString(), NumberStyles.Integer);
		var second1NormalTimePrev = int.Parse(britishTimePrev[6].ToString(), NumberStyles.Integer);
		var second2NormalTimePrev = int.Parse(britishTimePrev[7].ToString(), NumberStyles.Integer);
		var hour1ShaleTimePrev = int.Parse(shaleTimePrev[0].ToString(), NumberStyles.Integer);
		var hour2ShaleTimePrev = int.Parse(shaleTimePrev[1].ToString(), NumberStyles.Integer);
		var minute1ShaleTimePrev = int.Parse(shaleTimePrev[3].ToString(), NumberStyles.Integer);
		var minute2ShaleTimePrev = int.Parse(shaleTimePrev[4].ToString(), NumberStyles.Integer);
		var second1ShaleTimePrev = int.Parse(shaleTimePrev[6].ToString(), NumberStyles.Integer);
		var second2ShaleTimePrev = int.Parse(shaleTimePrev[7].ToString(), NumberStyles.Integer);

		hour1NormalTimeCont = $"{hour1NormalTimeCurr} {hour1NormalTimePrev}";
		hour2NormalTimeCont = $"{hour2NormalTimeCurr} {hour2NormalTimePrev}";
		minute1NormalTimeCont = $"{minute1NormalTimeCurr} {minute1NormalTimePrev}";
		minute2NormalTimeCont = $"{minute2NormalTimeCurr} {minute2NormalTimePrev}";
		second1NormalTimeCont = $"{second1NormalTimeCurr} {second1NormalTimePrev}";
		second2NormalTimeCont = $"{second2NormalTimeCurr} {second2NormalTimePrev}";
		hour1ShaleTimeCont = $"{hour1ShaleTimeCurr} {hour1ShaleTimePrev}";
		hour2ShaleTimeCont = $"{hour2ShaleTimeCurr} {hour2ShaleTimePrev}";
		minute1ShaleTimeCont = $"{minute1ShaleTimeCurr} {minute1ShaleTimePrev}";
		minute2ShaleTimeCont = $"{minute2ShaleTimeCurr} {minute2ShaleTimePrev}";
		second1ShaleTimeCont = $"{second1ShaleTimeCurr} {second1ShaleTimePrev}";
		second2ShaleTimeCont = $"{second2ShaleTimeCurr} {second2ShaleTimePrev}";
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);
	}
}