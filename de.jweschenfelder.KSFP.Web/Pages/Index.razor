					<img src="/imgs/icons/icons8-github-32-white.png" alt="GitHub" width="24" height="24" />
				</a>
				<BSTooltip Placement="Placement.Top" Target="tt-github">GitHub</BSTooltip>
			</div>
		</div>
</footer>
