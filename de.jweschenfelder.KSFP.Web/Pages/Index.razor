@page "/"
@inject IJSRuntime jsRuntime

<PageTitle>Kerry Shale Fanpage: Home</PageTitle>

<div class="section mt-5 pt-4">
	<div class="container">
		<div class="row mb-4 align-items-center">
			<div class="col-lg-4">
				<h2 class="heading">Welcome<span class="text-primary">.</span> </h2>
			</div>
			<div class="col-lg-4">
				<p class="text-black-50">
					A collection of current projects where Kerry Shale is working on, or where he is involved.
				</p>
			</div>
		</div>

		<div class="row g-1 align-items-center">
			<div class="col-12">
				<p class="text-black">
					<BSAlert Color="BSColor.Info">
						This is a fanpage operated by a fan, it is not operated by the real Kerry Shale! The official website of Kerry Shale can be found:
						<a href="https://www.kerryshale.com" target="_blank">HERE</a>! <br />
						This fanpage is not affiliated, associated, authorized, endorsed by, or in any way officially connected with Kerry Shale or his affiliates.
					</BSAlert>
				</p>
			</div>
		</div>

		<div class="row g-1 align-items-center">
			<div class="col-12">
				<p class="text-black">
					<BSAlert Color="BSColor.Success">
						Hint: There is some new gimmick on this page if you scroll down. ;-)
					</BSAlert>
				</p>
			</div>
		</div>

		<div class="row g-1 mb-4">
			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/Wednesday">
						<img src="/images/img_0.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>Wednesday, Season 2</h3>
							<div class="cat">Netflix series</div>
						</div>
					</a>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/Gumball">
						<img src="/images/img_2.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>The Amazing World Of Gumball</h3>
							<div class="cat">Comic series</div>
						</div>
					</a>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/IceAirportAlaska">
						<img src="/images/img_4.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>Ice Airport Alaska</h3>
							<div class="cat">Documentation series</div>
						</div>
					</a>
				</div>
			</div>

			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/ChickenPolice">
						<img src="/images/img_3.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>Chicken Police: Into The HIVE!</h3>
							<div class="cat">Video game series</div>
						</div>
					</a>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/Sandman">
						<img src="/images/img_1.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>The Sandman</h3>
							<div class="cat">Audio series</div>
						</div>
					</a>
				</div>
			</div>
			<div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="/Projects/DylanPodcast">
						<img src="/images/img_5.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>Is it Rolling, Bob? Talking Dylan</h3>
							<div class="cat">Podcast</div>
						</div>
					</a>
				</div>
			</div>
			@* <div class="col-xs-12 col-sm-6 col-md-6 col-lg-4">
				<div class="single-portfolio">
					<a href="#">
						<img src="/images/img_6.jpg" alt="Image" class="img-fluid" />
						<div class="contents">
							<h3>What is next?</h3>
							<div class="cat">...</div>
						</div>
					</a>
				</div>
			</div> *@
		</div>

		<div class="row my-5 g-1 align-items-center">
			<SubClock></SubClock>
		</div>

		<div class="row my-5 g-1 align-items-center">
			<SubCanvas></SubCanvas>
		</div>

	</div>
</div>

