					Disclaimer &amp; Privacy Protection
				</a>
			</div>
		</div>
		<div class="d-flex">
		</div>
		<div class="d-flex gap-1">
			<div class="icon-holder-black" data-blazorstrap="tt-bluesky">
				<a href="https://bsky.app/profile/kerryshalefanpage.bsky.social" target="_blank">
					<img src="/imgs/icons/icons8-bluesky-32-white.png" alt="Bluesky" width="24" height="24" />
				</a>
				<BSTooltip Placement="Placement.Top" Target="tt-bluesky">Bluesky</BSTooltip>
			</div>
			<div class="icon-holder-black" data-blazorstrap="tt-threads">
				<a href="@("https://www.threads.net/@kerryshalefanpage")" target="_blank">
					<img src="/imgs/icons/icons8-threads-32-white.png" alt="Threads" width="24" height="24" />
				</a>
				<BSTooltip Placement="Placement.Top" Target="tt-threads">Threads</BSTooltip>
			</div>
			<div class="icon-holder-black" data-blazorstrap="tt-facebook">
				<a href="https://www.facebook.com/groups/kerryshalefangroup" target="_blank">
					<img src="/imgs/icons/icons8-facebook-32-white.png" alt="Facebook" width="24" height="24" />
				</a>
				<BSTooltip Placement="Placement.Top" Target="tt-facebook">Facebook</BSTooltip>
			</div>
			<div class="icon-holder-black" data-blazorstrap="tt-youtube">
				<a href="@("https://www.youtube.com/@kerryshalefanpage")" target="_blank">
					<img src="/imgs/icons/icons8-youtube-32-white.png" alt="YouTube" width="24" height="24" />
				</a>
				<BSTooltip Placement="Placement.Top" Target="tt-youtube">YouTube</BSTooltip>
			</div>
			<div class="icon-holder-black" data-blazorstrap="tt-github">
