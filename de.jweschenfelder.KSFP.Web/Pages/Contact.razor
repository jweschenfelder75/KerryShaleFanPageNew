@page "/Contact"
@using System.Globalization
@using Microsoft.AspNetCore.Http.Extensions
@using System.Net.Mail
@using de.jweschenfelder.KSFP.Shared.Objects
@using de.jweschenfelder.KSFP.Web.Interfaces.MailAndSmsServices
@using BlazorCaptcha
@inject IGmailMailAndSmsService GmailMailAndSmsService

<PageTitle>Kerry Shale Fanpage: Contact</PageTitle>

<div class="section mt-5 pt-4 sec-contact">
	<div class="container">
		<div class="row mb-5 justify-content-center text-center">
			<div class="col-lg-5">
				<h2 class="heading">Get in touch</h2>
				<p class="text-black-50">Please watch your language when using this form, some words might be blocked.</p>
			</div>
		</div>

		<EditForm Model=@ContactData OnSubmit=@((args) => SubmitAsync(args))>
			<DataAnnotationsValidator />

			<div class="row">
				<div class="col-12 col-md-6 col-lg-6">
					<div class="mb-3">
						<label for="Name" class="mb-2">Name</label>
						<input type="text" class="form-control" id="Name" @bind-value="@ContactData.Name">
						@* <ValidationMessage For="@(() => ContactData.Name)" /> *@
					</div>
				</div>

				<div class="col-12 col-md-6 col-lg-6">
					<div class="mb-3">
						<label for="Email" class="mb-2">Email</label>
						<input type="text" class="form-control" id="Email" @bind-value="@ContactData.EMail">
						@* <ValidationMessage For="@(() => ContactData.EMail)" /> *@
					</div>
				</div>
			</div>

			<div class="col-md-12 col-lg-12">
				<div class="mb-3">
					<label for="Subject" class="mb-2">Subject</label>
					<input type="text" class="form-control" id="Subject" @bind-value="@ContactData.Subject">
					@* <ValidationMessage For="@(() => ContactData.Subject)" /> *@
				</div>
			</div>

			<div class="col-md-12 col-lg-12">
				<div class="mb-3">
					<label for="Message" class="mb-2">Message</label>
					<textarea class="form-control" id="Message" cols="30" rows="5" @bind="@ContactData.Message"></textarea>
					@* <ValidationMessage For="@(() => ContactData.Message)" /> *@
				</div>
			</div>

			<div class="col-md-12 col-lg-12">
				<div class="mb-2">
					<div class="row">
						<div class="col">
							<label for="ReEnteredCaptcha" class="mb-2">Please re-enter the text displayed in the image to ensure you are a human:</label>
						</div>
					</div>
					<div class="row">
						<div class="col-md-6">
							<input type="text" class="form-control" id="ReEnteredCaptcha" @bind="@ReEnteredCaptcha"></input>
							@* <ValidationMessage For="@(() => ReEnteredCaptcha)" /> *@
						</div>
						<div class="col-md-6">
							<div class="row captcha">
								<Captcha @bind-CaptchaWord="@Captcha" CharNumber="@CaptchaLetters" />
							</div>
						</div>
					</div>
				</div>
			</div>

			<div class="col-md-12 col-lg-12">
				<div class="mb-3">
					<span class="mb-2">If you have difficulties to read the text in the image, please use the refresh button next to it to generate another image.</span>
				</div>
			</div>

			<div class="col-md-12">
				<input type="submit" value="Send message" class="btn btn-primary">
			</div>

			<div class="col-md-12 col-lg-12">
				<div class="my-3 @((LastSubmitResult) ? "text-success" : "text-danger")">
					<strong>
						@LastSubmitResultString
						<ValidationSummary />
					</strong>
				</div>
			</div>

		</EditForm>

		<div class="col-md-12 col-lg-12">
			<div class="mt-5 text-center">
				For further assistance, you can reach out to a real person via voicebox/fax or e-mail <a href="https://jweschenfelder.de/pages/contact.html" target="_blank">here</a>, either in English or German.
			</div>
		</div>

	</div>
</div>

