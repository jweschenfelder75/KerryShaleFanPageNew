@page "/News"
@using de.jweschenfelder.KSFP.Shared.Objects
@using de.jweschenfelder.KSFP.Shared.Enums
@using de.jweschenfelder.KSFP.Web.Interfaces.BusinessLogic
@inject IGenericService<NewsItemDto> NewsService

<PageTitle>Kerry Shale Fanpage: News</PageTitle>

<div class="section mt-5 pt-4">
	<div class="container">
		<div class="row mb-4 align-items-center">
			<div class="col-lg-4">
				<h2 class="heading">News<span class="text-primary">.</span> </h2>
			</div>
			<div class="col-lg-4">
				<p class="text-black-50">
					Some news about Mr Shale.
				</p>
			</div>
		</div>

		@if (currentItems.Any())
		{
			var currItem = currentItems.FirstOrDefault() ?? new NewsItemDto();
			<div>
				<div class="row mb-5 justify-content-between">
					<div class="col-lg-6 text-black-100 order-lg-2">
						<p>
							<strong>@((MarkupString)(@currItem.HtmlTitleEn ?? String.Empty))</strong><br /><br />
							<strong>@((MarkupString)(@currItem.HtmlSubTitleEn ?? String.Empty))</strong><br /><br />
							@((MarkupString)(@currItem.HtmlBodyEn ?? String.Empty))
						</p>
						<p>
							More information:<br />
							@if (!String.IsNullOrWhiteSpace(@currItem.SecondaryUrlEn))
							{
								<div>
									Link #1: <a href="@currItem.PrimaryUrlEn" target="_blank">@currItem.PrimaryUrlEn</a><br />
									Link #2: <a href="@currItem.PrimaryUrlEn" target="_blank">@currItem.SecondaryUrlEn</a>
								</div>
							}
							else
							{
								<div>Link: <a href="@currItem.PrimaryUrlEn" target="_blank">@currItem.PrimaryUrlEn</a></div>
							}
						</p>
					</div>
					<div class="col-lg-5 ps-lg-4 float-start">
						<img src="@currItem.ImageUrlEn" alt="Image" class="img-fluid rounded-3" />
					</div>
				</div>
			</div>
		}

		@if (currentItems.Any() && currentItems.Count() > 1)
		{
			foreach (var item in currentItems)
			{
				var ind = currentItems.IndexOf(item);
				if (ind == 0) continue;

				<hr />

				<div>
					<div class="row my-5 justify-content-between">
						<div class="col-lg-6 text-black-100 order-lg-2">
							<p>
								<strong>@((MarkupString)(@item.HtmlTitleEn ?? String.Empty))</strong><br /><br />
								<strong>@((MarkupString)(@item.HtmlSubTitleEn ?? String.Empty))</strong><br /><br />
								@((MarkupString)(@item.HtmlBodyEn ?? String.Empty))
							</p>
							<p>
								More information:<br />
								@if (!String.IsNullOrWhiteSpace(@item.SecondaryUrlEn))
								{
									<div>
										Link #1: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a><br />
										Link #2: <a href="@item.PrimaryUrlEn" target="_blank">@item.SecondaryUrlEn</a>
									</div>
								}
								else
								{
									<div>Link: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a></div>
								}
							</p>
						</div>
						<div class="col-lg-5 ps-lg-4 float-start">
							<img src="images/netflix-wednesday-2022.jpg" alt="Image" class="img-fluid rounded-3" />
						</div>
					</div>
				</div>
			}
		}

		@if (unofficialItems.Any() || unconfirmedItems.Any())
		{
			<hr />

			<div>
				<div class="row my-5 justify-content-between">
					<div class="col-lg-12 text-black-100">
						<p>
							<strong>(2) Unofficial or unconfirmed news:</strong>
						</p>
						<p>
							<BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
								<BSTHead>
									<BSTR>
										<BSTD>When</BSTD>
										<BSTD>What</BSTD>
										<BSTD>Where</BSTD>
										<BSTD>Status</BSTD>
									</BSTR>
								</BSTHead>
								<BSTBody>
									@foreach (var item in unofficialItems)
									{
										<BSTR>
											<BSTD>@((MarkupString)(@item.HtmlSubTitleEn ?? String.Empty))</BSTD>
											<BSTD>
												@((MarkupString)(@item.HtmlTitleEn ?? String.Empty))<br />
												@if (!String.IsNullOrWhiteSpace(@item.SecondaryUrlEn))
												{
													<div>Link #1: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a><br />
														Link #2: <a href="@item.PrimaryUrlEn" target="_blank">@item.SecondaryUrlEn</a></div>
												} 
												else
												{
													<div>Link: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a></div>
												}
											</BSTD>
											<BSTD>@item.OptionalWhereEn</BSTD>
											<BSTD>@item.Category.ToString()</BSTD>
										</BSTR>
									}
									@foreach (var item in unconfirmedItems)
									{
										<BSTR>
											<BSTD>@((MarkupString)(@item.HtmlSubTitleEn ?? String.Empty))</BSTD>
											<BSTD>
												@((MarkupString)(@item.HtmlTitleEn ?? String.Empty))<br />
												@if (!String.IsNullOrWhiteSpace(@item.SecondaryUrlEn))
												{
													<div>
														Link #1: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a><br />
														Link #2: <a href="@item.PrimaryUrlEn" target="_blank">@item.SecondaryUrlEn</a>
													</div>
												}
												else
												{
													<div>Link: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a></div>
												}
											</BSTD>
											<BSTD>@item.OptionalWhereEn</BSTD>
											<BSTD>@item.Category.ToString()</BSTD>
										</BSTR>
									}
								</BSTBody>
							</BSTable>
						</p>
					</div>
				</div>
			</div>
		}

		@if (oldItems.Any())
		{
			<hr />

			<div>
				<div class="row my-5 justify-content-between">
					<div class="col-lg-12 text-black-100">
						<p>
							<strong>Archive/Old news: Missed something?</strong>
						</p>
						<p>
							<BSTable IsResponsive="true" IsStriped="true" IsBordered="true">
								<BSTHead>
									<BSTR>
										<BSTD>When</BSTD>
										<BSTD>What</BSTD>
										<BSTD>Where</BSTD>
									</BSTR>
								</BSTHead>
								<BSTBody>
									@foreach (var item in oldItems)
									{
										<BSTR>
											<BSTD>@((MarkupString)(@item.HtmlSubTitleEn ?? String.Empty))</BSTD>
											<BSTD>@((MarkupString)(@item.HtmlTitleEn ?? String.Empty))</BSTD>
											<BSTD>Link: <a href="@item.PrimaryUrlEn" target="_blank">@item.PrimaryUrlEn</a></BSTD>
										</BSTR>
									}
								</BSTBody>
							</BSTable>
						</p>
					</div>
				</div>
			</div>
		}

	</div>
</div>

@code {
	IList<NewsItemDto> items = new List<NewsItemDto>();
	IList<NewsItemDto> currentItems = new List<NewsItemDto>();
	IList<NewsItemDto> unofficialItems = new List<NewsItemDto>();
	IList<NewsItemDto> unconfirmedItems = new List<NewsItemDto>();
	IList<NewsItemDto> oldItems = new List<NewsItemDto>();

	protected override async Task OnInitializedAsync()
	{
		await base.OnInitializedAsync();
		items = NewsService.GetAll() ?? new List<NewsItemDto>();
		currentItems = items.Where(i => i.Category == NewsCategoryEnum.Current).ToList() ?? new List<NewsItemDto>();
		unofficialItems = items.Where(i => i.Category == NewsCategoryEnum.Unofficial).ToList() ?? new List<NewsItemDto>();
		unconfirmedItems = items.Where(i => i.Category == NewsCategoryEnum.Uncomfirmed).ToList() ?? new List<NewsItemDto>();
		oldItems = items.Where(i => i.Category == NewsCategoryEnum.Old).ToList() ?? new List<NewsItemDto>();
	}
}