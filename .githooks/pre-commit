#!/bin/sh

# git config --local core.hooksPath .githooks/
set -e

#=== 'prev-commit' solution by o_O Tync
commit_hash=$(git rev-parse --short=7 HEAD)
commit=$(git log --pretty="author:%an committer:%cn timestamp:%ci" -n 1)
commit_msg=$(echo "$commit" | head -1)

# Write it
echo "prev_commit_id='$commit_hash commit='$commit_msg'" > version.txt
